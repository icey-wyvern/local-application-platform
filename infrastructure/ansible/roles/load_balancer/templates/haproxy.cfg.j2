# Managed by Ansible.
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode tcp
    option tcplog
    option dontlognull
    timeout connect 5s
    timeout client 50s
    timeout server 50s

frontend kubernetes_api
    bind {{ lab.network.api_virtual_ip }}:{{ lap_api_port }}
    default_backend kubernetes_control_planes

backend kubernetes_control_planes
    option tcp-check
    tcp-check connect port {{ lap_api_port }}
{% for host in groups['control_planes'] | sort %}
    server {{ host }} {{ hostvars[host].ansible_host }}:{{ lap_api_port }} check inter 2s rise 2 fall 3
{% endfor %}

