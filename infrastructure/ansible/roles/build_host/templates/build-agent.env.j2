LAP_BUILD_AGENT_LISTEN_HOST={{ ansible_host }}
LAP_BUILD_AGENT_LISTEN_PORT={{ lab.build_agent.port }}
LAP_BUILD_AGENT_STATE_PATH={{ lab.build_agent.state_path }}
LAP_BUILDKIT_SOCKET={{ lab.build_host.buildkit_socket }}
LAP_TRIVY_CACHE_PATH={{ lab.build_host.trivy_cache_path }}
LAP_REGISTRY={{ lab.registry.host }}:{{ lab.registry.port }}
LAP_REGISTRY_NAMESPACE={{ lab.registry.image_namespace }}
LAP_REGISTRY_AUTH_FILE={{ lab.build_agent.state_path }}/registry-auth.json
LAP_VULNERABILITY_THRESHOLD={{ lap_build_agent_vulnerability_threshold }}
LAP_BUILD_TIMEOUT_SECONDS={{ lab.build_agent.build_timeout_minutes * 60 }}
OTEL_EXPORTER_OTLP_ENDPOINT=http://{{ hostvars[groups['workers'][0]].ansible_host }}:{{ lap_build_agent_otlp_node_port }}
